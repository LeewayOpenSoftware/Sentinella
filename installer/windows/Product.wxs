<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════
  UNBUILT AND UNSHIPPED — DO NOT TRUST AS MAINTAINED (2026-08-24)

  Nothing builds this file. No script in scripts/ invokes candle/light/
  wix, and tauri.conf.json targets ["nsis"] only — the shipped installer
  is NSIS (gui/src-tauri/nsis-hooks.nsh), which is where every install/
  uninstall fix lands. This WiX source is dormant and free to rot while
  looking maintained. Known stale spot if it is ever revived:
  registration of the DnsReconcile task is conditioned on
  `NOT Installed`, so a REPAIR would not re-register a deleted task.

  Read it as a design sketch only. Deleting it vs. shipping it is the
  owner's call (audit unit-3 spec d) — until then, verify any behaviour
  question against the NSIS hooks, never against this file.
  ═══════════════════════════════════════════════════════════════════

  Sentinella Antivirus — Windows Installer (WiX 4)

  Build requires:
  - WiX Toolset v4 (dotnet tool install -g wix)
  - Release binaries: cargo build (workspace, release profile)
  - ClamAV DLLs in target/release/ or build/clamav/
  - YARA rules in runtime/argus/rules/yara/

  Build command:
    wix build -d BuildDir=..\..\target\release ^
              -d ConfigDir=..\..\installer\windows ^
              -d RulesDir=..\..\runtime\argus\rules\yara ^
              -o sentinella-0.1.0.msi ^
              installer\windows\Product.wxs

  For YARA rules and certs, use WiX heat to harvest directories:
    wix heat dir runtime\argus\rules\yara -cg YaraRules -dr YARASUBDIR
    wix heat dir third_party\clamav\certs -cg CertFiles -dr CERTSDIR
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Sentinella Antivirus Suite"
    Version="0.1.0"
    Manufacturer="Lucent Open Software"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Sentinella is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ═══════════════════════════════════════════════════════════
         DIRECTORY STRUCTURE
         ═══════════════════════════════════════════════════════════ -->

    <!-- Program Files\Sentinella\ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Sentinella">
        <Directory Id="CERTSDIR" Name="certs" />
        <Directory Id="SCRIPTSDIR" Name="scripts" />
      </Directory>
    </StandardDirectory>

    <!-- ProgramData\Sentinella\ (runtime data — PathManager root in installed mode) -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIRPARENT" Name="Sentinella">
        <Directory Id="SIGDIR" Name="signatures" />
        <Directory Id="STATEDIR" Name="state" />
        <Directory Id="LOGDIR" Name="logs" />
        <Directory Id="QUARANTINEDIR" Name="quarantine" />
        <Directory Id="CONFIGDIR" Name="config" />
        <Directory Id="DATARULESDIR" Name="rules" />
        <Directory Id="DATAARGUSDIR" Name="argus">
          <Directory Id="DATAARGUSRULESDIR" Name="rules">
            <Directory Id="DATAYARADIR" Name="yara" />
          </Directory>
          <Directory Id="DATAMANIFESTDIR" Name="manifests" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- ═══════════════════════════════════════════════════════════
         FEATURES
         ═══════════════════════════════════════════════════════════ -->

    <Feature Id="MainFeature" Title="Sentinella Antivirus" Level="1">
      <ComponentGroupRef Id="DaemonComponents" />
      <ComponentGroupRef Id="ClamAVComponents" />
      <ComponentGroupRef Id="CLIComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
      <ComponentGroupRef Id="IntelligenceComponents" />
      <ComponentGroupRef Id="ScriptComponents" />
      <ComponentGroupRef Id="LegalComponents" />
    </Feature>

    <!-- ═══════════════════════════════════════════════════════════
         DAEMON + SERVICE
         ═══════════════════════════════════════════════════════════ -->

    <ComponentGroup Id="DaemonComponents" Directory="INSTALLFOLDER">
      <Component Id="DaemonExe">
        <File Source="$(var.BuildDir)\sentinelld.exe" KeyPath="yes" />
        <ServiceInstall
          Id="SentinelldService"
          Name="SentinellaDaemon"
          DisplayName="Sentinella Protection Service"
          Description="Sentinella antivirus daemon — ClamAV signatures + ARGUS heuristic intelligence engine."
          Type="ownProcess"
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Arguments="--log-level info --runtime-root &quot;[DATADIRPARENT]&quot; --dll-dir &quot;[INSTALLFOLDER]&quot; --db-dir &quot;[SIGDIR]&quot; --state-db &quot;[STATEDIR]\sentinella.db&quot;">
          <!-- Start="delayed" is NOT a legal WiX value (auto|demand|disabled)
               and this file has therefore never built. Delayed-auto is
               expressed as auto + this ServiceConfig, which is what was
               intended. -->
          <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
        </ServiceInstall>
        <ServiceControl
          Id="SentinelldControl"
          Name="SentinellaDaemon"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
      <!-- The boot-time NRPT reconciler. Its scheduled task is created by
           the CustomActions below rather than by the daemon at runtime:
           the reconciler is INFRASTRUCTURE and must exist before the first
           DNS policy rule can, which makes install time the only correct
           moment. It also keeps the product from writing its own
           persistence while running - a cleaner shape for any EDR watching,
           including our own ARGUS, whose schtasks detection stays honest
           because it needs no exception for us. -->
      <Component Id="DnsReconcilerExe">
        <File Id="DnsReconcilerExeFile"
              Source="$(var.BuildDir)\sentinella-dnsreconcile.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="ArgusWorkerExe">
        <File Source="$(var.BuildDir)\argusd.exe" />
      </Component>
    </ComponentGroup>

    <!-- ═══════════════════════════════════════════════════════════
         CLAMAV ENGINE
         ═══════════════════════════════════════════════════════════ -->

    <ComponentGroup Id="ClamAVComponents" Directory="INSTALLFOLDER">
      <Component Id="LibClamAV">
        <File Source="$(var.BuildDir)\libclamav.dll" />
      </Component>
      <Component Id="LibClamMSPack">
        <File Source="$(var.BuildDir)\libclammspack.dll" />
      </Component>
      <Component Id="FreshclamExe">
        <File Source="$(var.BuildDir)\freshclam.exe" />
      </Component>
    </ComponentGroup>

    <!-- ═══════════════════════════════════════════════════════════
         CLI
         ═══════════════════════════════════════════════════════════ -->

    <ComponentGroup Id="CLIComponents" Directory="INSTALLFOLDER">
      <Component Id="CLIExe">
        <File Source="$(var.BuildDir)\sentinella.exe" Name="sentinella-cli.exe" />
      </Component>
    </ComponentGroup>

    <!-- ═══════════════════════════════════════════════════════════
         CONFIGURATION TEMPLATES
         ═══════════════════════════════════════════════════════════ -->

    <ComponentGroup Id="ConfigComponents" Directory="CONFIGDIR">
      <Component Id="FreshclamConf">
        <File Source="$(var.ConfigDir)\freshclam.conf.template" Name="freshclam.conf" />
      </Component>
    </ComponentGroup>

    <!-- ═══════════════════════════════════════════════════════════
         ARGUS INTELLIGENCE
         ═══════════════════════════════════════════════════════════ -->

    <ComponentGroup Id="IntelligenceComponents" Directory="DATADIRPARENT">
      <!-- Pack manifest → ProgramData\Sentinella\argus\manifests\ -->
      <Component Id="PackManifest" Directory="DATAMANIFESTDIR">
        <File Source="..\..\runtime\argus\manifests\pack_manifest.json" />
      </Component>
      <!-- IOC hashes → ProgramData\Sentinella\rules\ -->
      <Component Id="IOCHashes" Directory="DATARULESDIR">
        <File Source="..\..\runtime\rules\ioc_hashes.txt" />
      </Component>
      <!--
        YARA rule files → ProgramData\Sentinella\argus\rules\yara\
        Use WiX heat to harvest: wix heat dir runtime\argus\rules\yara -cg YaraRules -dr DATAYARADIR -srd
      -->
    </ComponentGroup>

    <!-- ═══════════════════════════════════════════════════════════
         SCRIPTS
         ═══════════════════════════════════════════════════════════ -->

    <ComponentGroup Id="ScriptComponents" Directory="SCRIPTSDIR">
      <Component Id="ShellMenuScript">
        <File Source="..\..\scripts\install-shell-menu.bat" />
      </Component>
    </ComponentGroup>

    <!-- ═══════════════════════════════════════════════════════════
         LEGAL
         ═══════════════════════════════════════════════════════════ -->

    <ComponentGroup Id="LegalComponents" Directory="INSTALLFOLDER">
      <Component Id="LicenseFile">
        <File Source="..\..\LICENSE" Name="LICENSE.txt" />
      </Component>
    </ComponentGroup>


    <!-- ═══════════════════════════════════════════════════════════
         DNS RECONCILER TASK  (web protection lifecycle)
         ═══════════════════════════════════════════════════════════

         WHY ANY OF THIS EXISTS. Web protection points the whole machine's
         DNS at our local proxy with a Name Resolution Policy Table rule.
         That rule lives in the registry and SURVIVES REBOOTS, while the
         daemon that serves it is delayed-auto start. So the dangerous
         state is not "the proxy crashed" - it is "the rule is installed
         and nothing is answering", which is a machine with no name
         resolution at all, on every subsequent boot, for a user who cannot
         search for the fix because search does not resolve.

         The reconciler runs at boot, before the daemon, and removes the
         rule unless the proxy answers with our signature. It is the ONLY
         thing that removes rules. Which is why its task is created HERE,
         at install: it must exist before the first rule can, and no rule
         is ever installed by a build that lacks it.

         The binary registers its own task (via its install-task flag)
         rather than this file shipping task XML. The XML must name the executable's
         absolute path, which is only known at install time; asking the
         binary to do it replaces install-time templating with a
         current_exe() call. The settings it writes are not the schtasks
         command-line defaults, deliberately - see crates/
         sentinella-dnsreconcile/src/task.rs, where DisallowStartIfOnBatteries
         alone would stop a laptop from ever reconciling. -->

    <CustomAction Id="InstallDnsReconcileTask"
                  FileRef="DnsReconcilerExeFile"
                  ExeCommand="--install-task"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Rollback: if the install fails after the task was created, take it
         away again. An orphaned task is harmless (it removes rules that do
         not exist and exits 0), but leaving one behind after a failed
         install is the kind of litter that makes the next install's state
         ambiguous. -->
    <CustomAction Id="RollbackDnsReconcileTask"
                  FileRef="DnsReconcilerExeFile"
                  ExeCommand="--remove-task"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <!-- UNINSTALL, IN THIS ORDER: rule, then task, then binaries.
         Any other order strands something. Removing the task first would
         delete the remover while a rule is still live; removing the
         binaries first would delete the thing that knows how to remove the
         rule. Both actions are therefore sequenced BEFORE RemoveFiles,
         while the executable still exists. -->
    <!-- Return="check", NOT "ignore". A failure here ABORTS the uninstall,
         on purpose, and that is what gives the ladder a rung.

         The previous version used Return="ignore" with a comment claiming
         "the task survives and the next boot retries". It does not: with
         ignore, the MSI continues into RemoveFiles, which deletes
         sentinella-dnsreconcile.exe - so the surviving task points at a
         binary that no longer exists, and nothing can ever remove the rule.
         That is the exact stranded state this whole design prevents,
         reached through the uninstall path.

         With check, the sequence stops BEFORE RemoveFiles. Binaries and
         task both remain, the rule is still named, the next boot reconciles
         it away, and a retried uninstall then succeeds because the
         removal action is idempotent. Aborting is the unfriendly-but-recoverable outcome;
         continuing is the unrecoverable one. -->
    <CustomAction Id="RemoveNrptRule"
                  FileRef="DnsReconcilerExeFile"
                  ExeCommand="--remove"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Return="ignore" HERE is correct, and for a different reason than
         above: by this point the rule is gone (the previous action would
         have aborted otherwise), so a task that fails to unregister is
         litter, not a hazard - an orphaned task whose binary is about to be
         deleted simply exits non-zero at each boot. Blocking an uninstall
         over litter would be the wrong trade.

         The binary ALSO refuses to unregister itself while a rule is still
         installed. That check lives in the binary rather than in this
         sequencing precisely because sequencing is what a future edit gets
         wrong, and it holds for a hand-run command too. -->
    <CustomAction Id="RemoveDnsReconcileTask"
                  FileRef="DnsReconcilerExeFile"
                  ExeCommand="--remove-task"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RollbackDnsReconcileTask"
              Before="InstallDnsReconcileTask"
              Condition="NOT Installed" />
      <Custom Action="InstallDnsReconcileTask"
              After="InstallFiles"
              Condition="NOT Installed" />
      <Custom Action="RemoveNrptRule"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RemoveDnsReconcileTask"
              After="RemoveNrptRule"
              Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
